{
  "name": "sec-check",
  "version": "0.1.0",
  "description": "Security check for AI-built apps: leaked keys, missing Supabase RLS, open Firebase rules.",
  "type": "module",
  "bin": {
    "sec-check": "scanner/cli.js"
  },
